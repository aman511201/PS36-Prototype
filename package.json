{
  "name": "ps36-prototpye",
  "version": "1.0.0",
  "description": "National Online Verification System for Weighing and Measuring Instruments (Maanak / NLMVS - SIH 26036)",
  "scripts": {
    "dev:server": "python backend/run.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:client": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"SERVER,FRONTEND\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "python backend/run.py",
    "test:server": "python -m unittest backend/test_backend.py",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
